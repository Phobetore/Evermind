# Copy to .env and adjust. Nothing here is required: Evermind starts without a
# .env at all. These are the knobs, with their defaults shown. With Docker, apply
# a change with `docker compose up -d`: `docker compose restart` would go on with
# the settings the container started with.
#
# Write values exactly as they are: NAME=value with no spaces around =, no quotes,
# and no comment after a value.
# With Docker, only the .env next to docker-compose.yml is read. Compose may warn
# about an unset variable after a `$` in a value: that is harmless, but a `${`
# with no `}` after it is refused.

# Port Evermind answers on, interface and API together. Change it if something
# else already has 3000: with Docker this is the port on your machine, with the
# launch scripts it is the port Evermind itself listens on.
PORT=3000

# Development only (python -m app --dev): the port of the API behind the development
# server, which forwards /api to it. Production and Docker never use it.
EVERMIND_BACKEND_PORT=8000

# Which interface to listen on. The default keeps Evermind on this computer and
# nowhere else.
#
# To play from your phone or tablet on the same Wi-Fi, set BIND=0.0.0.0 AND set
# a password below. Without one, anybody on that network can open your
# conversations. This is meant for a home network, never the open internet.
BIND=127.0.0.1

# Password asked for before Evermind can be used. Empty means no password,
# which is the default because nothing outside this computer can reach Evermind
# until you change BIND above. Each device asks for it once, then stays
# signed in until it is signed out in Settings. Changing the password signs
# everyone out. An accented letter counts the same however it was composed, so
# the password matches whether a phone keyboard or the editor of this file wrote it.
# Without a password, Evermind only answers when it is opened by an address
# (127.0.0.1, 192.168.1.42) or by localhost, which keeps a website from reaching
# it under a name of its own. With one, any name works.
EVERMIND_GATE_PASSWORD=

# Which published image to run. "latest" tracks the newest release; pin a
# version such as 3.0.0 if you would rather upgrade on purpose (the image has
# no versions before 3.0.0).
EVERMIND_VERSION=latest

# Semantic long-term memory (embeddings). "true" enables relevance-based recall
# of facts and old passages instead of recency-based. It bakes
# sentence-transformers and torch into the image (~2-3 GB), so it only applies
# when you compile locally: docker compose up -d --build
SEMANTIC=false

# Reminder: your LLM runs on the HOST. In the app's LLM connection use
#   http://host.docker.internal:1234/v1   (LM Studio example)
