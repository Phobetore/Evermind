# Copy to .env and adjust. All values are optional (defaults shown).

# Port the web UI is served on (host side).
PORT=3000

# LAN gate password. Empty string DISABLES the gate entirely (local-only use).
# Anything else requires it before the UI or API can be reached.
EVERMIND_GATE_PASSWORD=ouistiti

# Semantic long-term memory (embeddings). "true" bakes sentence-transformers +
# torch into the backend image (~2-3 GB) and enables relevance-based fact/passage
# recall. "false" keeps a light image and recency-based memory.
SEMANTIC=false

# Reminder: your LLM runs on the HOST. In the app's LLM connection use
#   http://host.docker.internal:1234/v1   (LM Studio example)
