{
 "cases": [
  {
   "fn": "clean_card_draft",
   "name": "an empty draft",
   "input": {
    "draft": {}
   },
   "expected": {}
  },
  {
   "fn": "clean_card_draft",
   "name": "every text field",
   "input": {
    "draft": {
     "name": "The name.",
     "tagline": "The tagline.",
     "description": "The description.",
     "personality": "The personality.",
     "scenario": "The scenario.",
     "greeting": "The greeting.",
     "example_dialogues": "The example_dialogues."
    }
   },
   "expected": {
    "name": "The name.",
    "tagline": "The tagline.",
    "description": "The description.",
    "personality": "The personality.",
    "scenario": "The scenario.",
    "greeting": "The greeting.",
    "example_dialogues": "The example_dialogues."
   }
  },
  {
   "fn": "clean_card_draft",
   "name": "text fields are stripped like Python strips",
   "input": {
    "draft": {
     "name": "  Kenji  ",
     "tagline": "\u00a0Nbsp\u00a0",
     "description": "\u0085Nel\u0085",
     "personality": "\u001cFs\u001f",
     "scenario": "\u3000Ideographic\u3000",
     "greeting": "\u2028Line\u2029",
     "example_dialogues": "\u000b\fVertical\r\n"
    }
   },
   "expected": {
    "name": "Kenji",
    "tagline": "Nbsp",
    "description": "Nel",
    "personality": "Fs",
    "scenario": "Ideographic",
    "greeting": "Line",
    "example_dialogues": "Vertical"
   }
  },
  {
   "fn": "clean_card_draft",
   "name": "text fields keep a byte order mark and a zero width space",
   "input": {
    "draft": {
     "name": "\ufeffKenji",
     "tagline": "\u200bZero width\u200b"
    }
   },
   "expected": {
    "name": "\ufeffKenji",
    "tagline": "\u200bZero width\u200b"
   }
  },
  {
   "fn": "clean_card_draft",
   "name": "text fields keep what is inside",
   "input": {
    "draft": {
     "greeting": "*Rain.*\n\n  Two  spaces\tand a tab."
    }
   },
   "expected": {
    "greeting": "*Rain.*\n\n  Two  spaces\tand a tab."
   }
  },
  {
   "fn": "clean_card_draft",
   "name": "empty text fields are left out",
   "input": {
    "draft": {
     "name": "",
     "tagline": "   ",
     "description": "\n\t",
     "personality": "\u00a0",
     "scenario": "Kept."
    }
   },
   "expected": {
    "scenario": "Kept."
   }
  },
  {
   "fn": "clean_card_draft",
   "name": "text fields that are not text are left out",
   "input": {
    "draft": {
     "name": [
      "Kenji"
     ],
     "tagline": 12,
     "description": 1.5,
     "personality": true,
     "scenario": null,
     "greeting": {
      "a": 1
     },
     "example_dialogues": false
    }
   },
   "expected": {}
  },
  {
