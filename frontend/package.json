{
  "name": "evermind-frontend",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:e2e": "node e2e/clean-data.mjs && vite build --outDir dist-e2e && playwright test",
    "test:e2e:ui": "node e2e/clean-data.mjs && vite build --outDir dist-e2e && playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "minimatch": "^11.0.1"
  }
}
