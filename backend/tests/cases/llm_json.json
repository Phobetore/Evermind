{
 "cases": [
  {
   "fn": "parse_llm_json",
   "name": "a bare object",
   "input": {
    "text": "{\"a\": 1, \"b\": \"x\"}"
   },
   "expected": {
    "a": 1,
    "b": "x"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a json fence",
   "input": {
    "text": "Here is the card:\n```json\n{\"name\": \"Kenji\"}\n```\nHave a good game!"
   },
   "expected": {
    "name": "Kenji"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a fence in capitals",
   "input": {
    "text": "```JSON\n{\"a\": 1}\n```"
   },
   "expected": {
    "a": 1
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "text after with braces",
   "input": {
    "text": "{\"a\": 1} then {\"b\": 2} and {nothing}"
   },
   "expected": {
    "a": 1
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "two objects",
   "input": {
    "text": "{\"a\": 1} {\"b\": 2}"
   },
   "expected": {
    "a": 1
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a list",
   "input": {
    "text": "[\"a\", \"b\"]"
   },
   "expected": null
  },
  {
   "fn": "parse_llm_json",
   "name": "nothing",
   "input": {
    "text": ""
   },
   "expected": null
  },
  {
   "fn": "parse_llm_json",
   "name": "a truncated object",
   "input": {
    "text": "{\"a\": 1, \"b\": "
   },
   "expected": null
  },
  {
   "fn": "parse_llm_json",
   "name": "trailing commas in a list and an object",
   "input": {
    "text": "{\"name\": \"Kenji\", \"tags\": [\"a\", \"b\",],}"
   },
   "expected": {
    "name": "Kenji",
    "tags": [
     "a",
     "b"
    ]
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "trailing commas after spaces and lines",
   "input": {
    "text": "{\"a\": [1, 2 ,  \n ] ,\t\n }"
   },
   "expected": {
    "a": [
     1,
     2
    ]
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a fence and trailing commas",
   "input": {
    "text": "```json\n{\n  \"name\": \"Kenji\",\n  \"tags\": [\"a\", \"b\",],\n}\n```"
   },
   "expected": {
    "name": "Kenji",
    "tags": [
     "a",
     "b"
    ]
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a comma and brace in a string, when the text needs repair",
   "input": {
    "text": "{\"a\": \"x, }\n\", }"
   },
   "expected": {
    "a": "x, }\n"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "literal line feeds, carriage returns and tabs in a string",
   "input": {
    "text": "{\"greeting\": \"*The rain falls.*\nYou are here.\r\n\tCome closer.\"}"
   },
   "expected": {
    "greeting": "*The rain falls.*\nYou are here.\r\n\tCome closer."
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a literal line feed after an escaped backslash",
   "input": {
    "text": "{\"path\": \"C:\\\\dir\\\\\", \"note\": \"a\nb\"}"
   },
   "expected": {
    "path": "C:\\dir\\",
    "note": "a\nb"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a surrogate pair",
   "input": {
    "text": "{\"a\": \"\\ud83d\\ude00\"}"
   },
   "expected": {
    "a": "😀"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a high surrogate and a bad second escape",
   "input": {
    "text": "{\"a\": \"\\ud83d\\u00g0\"}"
   },
   "expected": null
  },
  {
   "fn": "parse_llm_json",
   "name": "duplicate keys: the last wins",
   "input": {
    "text": "{\"a\": 1, \"a\": 2}"
   },
   "expected": {
    "a": 2
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a key named __proto__",
   "input": {
    "text": "{\"__proto__\": {\"x\": 1}, \"a\": 2}"
   },
   "expected": {
    "__proto__": {
     "x": 1
    },
    "a": 2
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a key named constructor",
   "input": {
    "text": "{\"constructor\": {\"prototype\": 1}, \"toString\": 2, \"hasOwnProperty\": 3}"
   },
   "expected": {
    "constructor": {
     "prototype": 1
    },
    "toString": 2,
    "hasOwnProperty": 3
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a byte order mark before the object",
   "input": {
    "text": "\ufeff{\"a\": 1}"
   },
   "expected": {
    "a": 1
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a no-break space inside is not JSON whitespace",
   "input": {
    "text": "{\"a\":\u00a01}"
   },
   "expected": null
  },
