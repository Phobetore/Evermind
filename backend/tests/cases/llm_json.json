  {
   "fn": "parse_llm_json",
   "name": "NaN and the infinities are read as null",
   "input": {
    "text": "{\"a\": NaN, \"b\": [Infinity, -Infinity], \"c\": \"NaN\"}"
   },
   "expected": {
    "a": null,
    "b": [
     null,
     null
    ],
    "c": "NaN"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "NaN in a reply that needs repair",
   "input": {
    "text": "{\"a\": NaN, \"b\": \"x\ny\",}"
   },
   "expected": {
    "a": null,
    "b": "x\ny"
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "a thought before the object is skipped",
   "input": {
    "text": "<think>{\"wrong\": true}</think>\n{\"right\": true}"
   },
   "expected": {
    "right": true
   }
  },
  {
   "fn": "parse_llm_json",
   "name": "an unclosed thought gives nothing",
   "input": {
    "text": "<think>{\"a\": 1}"
   },
   "expected": null
  },
  {
   "fn": "parse_llm_json",
   "name": "a thought that opens late is not a thought",
   "input": {
    "text": "Sure. <think>x</think> {\"a\": 1}"
   },
   "expected": {
    "a": 1
   }
  },
  {
   "fn": "partial_json",
   "name": "a whole answer is read whole",
   "input": {
    "text": "{\"name\": \"Ana\", \"tags\": [\"a\"]}"
   },
   "expected": {
    "fields": {
     "name": "Ana",
     "tags": [
      "a"
     ]
    },
    "writing": null
   }
  },
  {
   "fn": "partial_json",
   "name": "a whole answer after a brace in the prose is read whole",
   "input": {
    "text": "Use {curly} braces? Here:\n```json\n{\"name\": \"Ana\"}\n```"
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": null
   }
  },
  {
   "fn": "partial_json",
   "name": "a field being written is named",
   "input": {
    "text": "{\"name\": \"Ana\", \"tagline\": \"A sto"
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": "tagline"
   }
  },
  {
   "fn": "partial_json",
   "name": "a list cut in the middle keeps its whole elements",
   "input": {
    "text": "{\"name\": \"Ana\", \"tags\": [\"a\", \"b\", \"c"
   },
   "expected": {
    "fields": {
     "name": "Ana",
     "tags": [
      "a",
      "b"
     ]
    },
    "writing": "tags"
   }
  },
  {
   "fn": "partial_json",
   "name": "a list of entries cut inside an entry keeps the whole ones",
   "input": {
    "text": "{\"lore_entries\": [{\"keys\": [\"a\"], \"content\": \"x\"}, {\"keys\": [\"b\""
   },
   "expected": {
    "fields": {
     "lore_entries": [
      {
       "keys": [
        "a"
       ],
       "content": "x"
      }
     ]
    },
    "writing": "lore_entries"
   }
  },
  {
   "fn": "partial_json",
   "name": "a forgotten comma between two fields",
   "input": {
    "text": "{\"name\": \"Ana\" \"tagline\": \"x\", \"description\": \"A ba"
   },
   "expected": {
    "fields": {
     "name": "Ana",
     "tagline": "x"
    },
    "writing": "description"
   }
  },
  {
   "fn": "partial_json",
   "name": "a field name not yet whole",
   "input": {
    "text": "{\"name\": \"Ana\", \"tag"
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": null
   }
  },
  {
   "fn": "partial_json",
   "name": "a field name with no colon yet",
   "input": {
    "text": "{\"name\": \"Ana\", \"tagline\" "
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": "tagline"
   }
  },
  {
   "fn": "partial_json",
   "name": "a number may still grow",
   "input": {
    "text": "{\"name\": \"Ana\", \"age\": 12"
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": "age"
   }
  },
  {
   "fn": "partial_json",
   "name": "a number followed by a comma is whole",
   "input": {
    "text": "{\"name\": \"Ana\", \"age\": 12,"
   },
   "expected": {
    "fields": {
     "name": "Ana",
     "age": 12
    },
    "writing": null
   }
  },
  {
   "fn": "partial_json",
   "name": "prose and a thought before the cut answer",
   "input": {
    "text": "<think>{\"no\": 1}</think>Here: {\"name\": \"Ana\", \"greeting\": \"Hel"
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": "greeting"
   }
  },
  {
   "fn": "partial_json",
   "name": "a literal line feed in a field and an escaped quote in the next",
   "input": {
    "text": "{\"description\": \"line\nnext\", \"greeting\": \"She said \\\"hi"
   },
   "expected": {
    "fields": {
     "description": "line\nnext"
    },
    "writing": "greeting"
   }
  },
  {
   "fn": "partial_json",
   "name": "a value that cannot be read ends the reading",
   "input": {
    "text": "{\"name\": Ana, \"tagline\": \"x"
   },
   "expected": {
    "fields": {},
    "writing": null
   }
  },
  {
   "fn": "partial_json",
   "name": "NaN in a whole field is null",
   "input": {
    "text": "{\"age\": NaN, \"name\": \"A"
   },
   "expected": {
    "fields": {
     "age": null
    },
    "writing": "name"
   }
  },
  {
   "fn": "partial_json",
   "name": "nothing that opens an object",
   "input": {
    "text": "Sure, here is"
   },
   "expected": {
    "fields": {},
    "writing": null
   }
  },
  {
   "fn": "partial_json",
   "name": "a field whose value has not started is being written",
   "input": {
    "text": "{\"name\": \"Ana\", \"tagline\": "
   },
   "expected": {
    "fields": {
     "name": "Ana"
    },
    "writing": "tagline"
   }
  },
  {
   "fn": "partial_json",
   "name": "a brace inside a string of a whole entry",
   "input": {
    "text": "{\"lore_entries\": [{\"keys\": [\"a\"], \"content\": \"x } y\"}], \"name\": \"Ana\", \"tagline\": \"A"
   },
   "expected": {
    "fields": {
     "lore_entries": [
      {
       "keys": [
        "a"
       ],
       "content": "x } y"
      }
     ],
     "name": "Ana"
    },
    "writing": "tagline"
   }
  },
  {
   "fn": "partial_json",
   "name": "a list stops at an element that cannot be read",
   "input": {
    "text": "{\"tags\": [\"a\", b, \"c\", \"d"
   },
   "expected": {
    "fields": {
     "tags": [
      "a"
     ]
    },
    "writing": "tags"
   }
  }
 ]
}
